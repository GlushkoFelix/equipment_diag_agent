# 设备故障诊断智能体后端配置（复制为仓库根目录 .env）
EDG_DB_PATH=E:/equipment_diag_agent/storage/app.db
EDG_CHECKPOINT_PATH=E:/equipment_diag_agent/storage/checkpoints.sqlite3
EDG_STORAGE_DIR=E:/equipment_diag_agent/storage
EDG_UPLOAD_DIR=E:/equipment_diag_agent/storage/uploads
EDG_KNOWLEDGE_DIR=E:/equipment_diag_agent/storage/knowledge
EDG_BGE_M3_PATH=E:/equipment_diag_agent/models/bge-m3
EDG_DATASET_PATH=E:/equipment_diag_agent/data/ai4i2020.csv

# auto：优先 BGE-M3，缺依赖时回退 hash（health 中 embedding_model 仍为 ok）
EDG_EMBEDDING_MODE=auto
# deepseek | fake | disabled
EDG_LLM_MODE=deepseek
EDG_DEEPSEEK_API_KEY=
EDG_DEEPSEEK_BASE_URL=https://api.deepseek.com
EDG_DEEPSEEK_MODEL=deepseek-chat

EDG_APP_ORIGIN=http://127.0.0.1:8000
EDG_CSRF_ENFORCE=false
